{
  "name": "dsh-strong-skills",
  "version": "0.3.0",
  "description": "Lean coding skills and bounded workspace tools for DeepSeek Harness, with a built-in stdio MCP server.",
  "repository": { "type": "git", "url": "git+https://github.com/wemebabo57-a11y/dsh-mcp-strong-and-skills.git" },
  "homepage": "https://github.com/wemebabo57-a11y/dsh-mcp-strong-and-skills#readme",
  "bugs": { "url": "https://github.com/wemebabo57-a11y/dsh-mcp-strong-and-skills/issues" },
  "type": "module",
  "main": "./src/index.mjs",
  "exports": { ".": "./src/index.mjs", "./engine": "./src/engine.mjs", "./client": "./client/client.js" },
  "bin": { "dsh-strong": "./bin/strong.mjs" },
  "files": ["src", "bin", "client", "skills", "examples", "docs", "scripts", "test", "cordis.patch.yml", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE"],
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.1-rc.3 <0.3.0" },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "budget": "node bin/strong.mjs budget",
    "build:ui": "node scripts/build-ui.mjs",
    "mcp": "node bin/strong.mjs serve --root .",
    "prepack": "npm run check && npm test"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "mcp", "skills", "coding"],
  "license": "MIT",
  "peerDependencies": { "@deepseek-ai/schemastery": "~3.18.5" },
  "peerDependenciesMeta": { "@deepseek-ai/schemastery": { "optional": true } },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-general", "@deepseek-ai/dsh-client-ui-plugin-manager"] } }
}
